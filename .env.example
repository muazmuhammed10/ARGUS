# ============================================================
# ARGUS — Environment Variable Template
# ============================================================
# 1. Copy this file:  Copy-Item .env.example .env
# 2. Fill in all CHANGE_ME values
# 3. NEVER commit the actual .env file (it is in .gitignore)
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=ARGUS
APP_VERSION=1.0.0
DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Security ---
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key_64_bytes_hex
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# --- Database (Local PostgreSQL) ---
# Create the database first: psql -U postgres -c "CREATE DATABASE argus_db;"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=argus_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_your_postgres_password
# URL-encode special characters in your password:
#   @ → %40   # → %23   $ → %24   ! → %21   & → %26
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_your_postgres_password@localhost:5432/argus_db

# --- Redis (optional for local dev — not required to run) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Optional: AI Provider ---
# Leave AI_PROVIDER=none to use deterministic fallback summaries (no key needed)
# Supported values: openai | anthropic | none
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Optional: Threat Intelligence ---
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=ARGUS
VITE_APP_VERSION=1.0.0

# --- Seed Data ---
# Set to true to auto-seed on first startup via seed script
SEED_DATABASE=true
SEED_ADMIN_EMAIL=admin@argus.local
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_12chars_min
