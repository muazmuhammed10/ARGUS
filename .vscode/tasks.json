{
  "version": "2.0.0",
  "tasks": [
    // ── Backend ────────────────────────────────────────────────────
    {
      "label": "🚀 Start Backend",
      "type": "shell",
      "command": ".venv\\Scripts\\uvicorn.exe app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": { "APP_ENV": "development" }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "argus"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "ARGUS starting up",
          "endsPattern": "Application startup complete"
        }
      }
    },

    // ── Frontend ───────────────────────────────────────────────────
    {
      "label": "🌐 Start Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "argus"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      }
    },

    // ── Full Stack ─────────────────────────────────────────────────
    {
      "label": "🔗 Full Stack",
      "dependsOn": ["🚀 Start Backend", "🌐 Start Frontend"],
      "group": { "kind": "build", "isDefault": true }
    },

    // ── Migrations ─────────────────────────────────────────────────
    {
      "label": "🗄️ Run Migrations",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m scripts.migrate_safe",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ── Seed ──────────────────────────────────────────────────────
    {
      "label": "🌱 Seed Database",
      "type": "shell",
      "command": ".venv\\Scripts\\python.exe -m scripts.seed",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ── Tests ─────────────────────────────────────────────────────
    {
      "label": "🧪 Backend Tests",
      "type": "shell",
      "command": ".venv\\Scripts\\pytest.exe tests/ -v --tb=short",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": { "APP_ENV": "test" }
      },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "🧪 Frontend Tests",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },

    // ── Install ───────────────────────────────────────────────────
    {
      "label": "📦 Install Frontend Deps",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "📦 Install Backend Deps",
      "type": "shell",
      "command": ".venv\\Scripts\\pip.exe install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "none",
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
