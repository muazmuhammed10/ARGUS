{
  "version": "0.2.0",
  "configurations": [
    // ── Backend ──────────────────────────────────────────────────
    {
      "name": "🚀 Backend (uvicorn)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "APP_ENV": "development"
      },
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },

    // ── Backend Tests ─────────────────────────────────────────────
    {
      "name": "🧪 Backend Tests (pytest)",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/",
        "-v",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "APP_ENV": "test"
      },
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ── Single test file ──────────────────────────────────────────
    {
      "name": "🧪 Test Current File",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "--tb=short"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "APP_ENV": "test"
      },
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": false
    },

    // ── Migration helper ──────────────────────────────────────────
    {
      "name": "🗄️ Run Migrations",
      "type": "python",
      "request": "launch",
      "module": "scripts.migrate_safe",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },

    // ── Seed data ─────────────────────────────────────────────────
    {
      "name": "🌱 Seed Database",
      "type": "python",
      "request": "launch",
      "module": "scripts.seed",
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/.env",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },

    // ── Frontend ──────────────────────────────────────────────────
    {
      "name": "🌐 Frontend (Vite dev)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:.*http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ],

  // ── Compound: launch both at once ──────────────────────────────
  "compounds": [
    {
      "name": "🔗 Full Stack (Backend + Frontend)",
      "configurations": [
        "🚀 Backend (uvicorn)",
        "🌐 Frontend (Vite dev)"
      ],
      "stopAll": true
    }
  ]
}
