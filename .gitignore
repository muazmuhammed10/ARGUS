# ============================================================
# ARGUS — .gitignore
# ============================================================

# ── Secrets & environment ─────────────────────────────────────
# NEVER commit .env — it contains database passwords and secret keys
.env
.env.local
.env.production
.env.staging
.env.test
*.env
!.env.example

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Vite cache ────────────────────────────────────────────────
.vite/

# ── Build outputs ─────────────────────────────────────────────
dist/
build/
out/

# ── Docker ────────────────────────────────────────────────────
.docker/

# ── IDE / Editor ──────────────────────────────────────────────
# Share VS Code workspace config (launch, tasks, extensions, settings)
# but ignore personal/machine-specific files
.vscode/*.log
.idea/
*.swp
*.swo
*~
*.orig

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Database ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Alembic ───────────────────────────────────────────────────
# Keep migration scripts, ignore generated cache
backend/alembic/versions/__pycache__/

# ── Test artifacts ────────────────────────────────────────────
backend/htmlcov/
backend/.pytest_cache/
frontend/coverage/

# ── Temporary / generated files ───────────────────────────────
backend/uploads/
backend/tmp/
sample_data/generated/
*.tmp
*.bak

# ── Secrets (never commit) ────────────────────────────────────
secrets/
credentials/
*.pem
*.key
*.cert
*.crt

# ── Misc project artifacts ────────────────────────────────────
py_err.txt
py_version.txt
test_err.txt
test_out.txt
DEVELOPMENT_STATUS.md
